# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix, never read client-side).
# Required: the API route fails closed with a 500 if this is not set.
INTERNAL_IMAGE_API_BASE_URL=http://127.0.0.1:8080

# Optional fallback API key for server-proxy mode when the user doesn't supply their own.
OPENAI_API_KEY=

# Optional static asset prefix for sub-path or CDN deployments.
NEXT_ASSET_PREFIX=

# Optional tldraw license key for the /canvas route. Without it the canvas
# still works, just with a tldraw watermark. Client-side by necessity.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Local UI/UX debugging: set to 1 to answer /api/images with generated placeholder
# images instead of calling the upstream API (no API key needed). Never enable in
# production — every result is fake. `npm run dev:mock` sets this for you.
IMAGE_API_MOCK=
# Simulated latency per request in ms (default 900, jittered ±40%).
IMAGE_API_MOCK_DELAY_MS=
# Fraction of mock requests that fail with a 502, to exercise retry/error UI (0-1, default 0).
IMAGE_API_MOCK_FAIL_RATE=

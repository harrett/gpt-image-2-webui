# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix, never read client-side).
# Required: the API route fails closed with a 500 if this is not set.
# Points at the sub2api gateway, which is where billing happens; the third-party
# upstream it relays to (base URL + key) is configured in sub2api's own admin, never here.
# A bare host is fine — normalizeOpenAIBaseURL appends /v1.
INTERNAL_IMAGE_API_BASE_URL=http://127.0.0.1:8080

# Optional fallback API key, used only when the request carries no key of its own.
# Leave empty when every user brings their own gateway key — an unnoticed value
# here would silently bill the whole deployment to one account.
OPENAI_API_KEY=

# Set to 1 to ask the upstream for base64 image data (`response_format: b64_json`)
# instead of a hosted URL. Required for relay gateways that answer with URLs:
# a URL would leak the upstream address to the browser, be fetched cross-origin,
# and hide the real download from the transfer progress bar.
# Must stay empty for OpenAI's own endpoint — it rejects the parameter for GPT
# image models, which always return base64 anyway.
IMAGE_REQUEST_B64_JSON=

# Compression level 0-100 for WebP/JPEG output (default 80; PNG ignores it).
# This is what makes WebP actually smaller than PNG — upstream defaults to 100,
# which is near-lossless and barely shrinks anything.
# Set to "off" to omit the parameter entirely for upstreams that reject it.
IMAGE_OUTPUT_COMPRESSION=

# Optional static asset prefix for sub-path or CDN deployments.
NEXT_ASSET_PREFIX=

# Local UI/UX debugging: set to 1 to answer /api/images with generated placeholder
# images instead of calling the upstream API (no API key needed). Never enable in
# production — every result is fake. `npm run dev:mock` sets this for you.
IMAGE_API_MOCK=
# Simulated latency per request in ms (default 900, jittered ±40%).
IMAGE_API_MOCK_DELAY_MS=
# Fraction of mock requests that fail with a 502, to exercise retry/error UI (0-1, default 0).
IMAGE_API_MOCK_FAIL_RATE=
